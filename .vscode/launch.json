{
    // Run whichever script is open in the editor, in an integrated terminal so
    // the input() prompts in these tutorials work interactively.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
